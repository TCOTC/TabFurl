  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "extension dev",
    "start": "extension start",
    "preview": "extension preview",
    "build": "extension build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tools/ts-hooks.mjs --test",
    "verify": "node tools/verify-build.mjs",
    "icons": "node tools/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "extension": "4.1.30",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.3"
}
